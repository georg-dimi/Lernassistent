# Anthropic API-Schlüssel (alternativ in der App unter "Einstellungen" eintragen)
ANTHROPIC_API_KEY=

# Optional: Port des Servers (Standard: 3000)
PORT=3000

# Optional: Claude-Modell (Standard: claude-sonnet-5)
CLAUDE_MODEL=claude-sonnet-5

# Optional: Passwortschutz für öffentliche Deployments (Basic Auth).
# Leer lassen für lokale Nutzung ohne Passwort.
APP_PASSWORD=

# Optional: Verzeichnis für Datenbank und Uploads (Standard: ./data)
DATA_DIR=
